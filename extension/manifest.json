{
  "manifest_version": 3,
  "name": "EchoMind Assistant",
  "version": "1.0.0",
  "description": "Record and transcribe Google Meet, Zoom, and Teams meetings to EchoMind.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*",
    "http://localhost:5173/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:3000/*",
    "http://127.0.0.1:5173/*",
    "http://127.0.0.1:5000/*",
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://localhost:3000/*",
        "http://localhost:3001/*",
        "http://localhost:5173/*",
        "http://localhost:5000/*",
        "http://127.0.0.1:3000/*",
        "http://127.0.0.1:5173/*",
        "http://127.0.0.1:5000/*",
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
